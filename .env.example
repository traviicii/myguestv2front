# Required when EXPO_PUBLIC_USE_MOCK_DATA=false.
# Keep this pointed at your local backend unless you intentionally want a remote environment.
EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:8000/api/v1
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_SITE_URL=
EXPO_PUBLIC_PRIVACY_POLICY_URL=
EXPO_PUBLIC_SUPPORT_URL=
EXPO_PUBLIC_USE_MOCK_DATA=false
# Optional fallback for one-off development requests:
EXPO_PUBLIC_DEV_ID_TOKEN=
